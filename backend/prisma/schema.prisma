// True Beauty - Prisma Schema
// Generated from: ERD (True_Beauty_ERD_final.drawio.xml), OpenAPI (backend/docs/openapi.yml), and Frontend TypeScript types

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum AdminRole {
  admin
  super_admin
}

enum UserKycStatus {
  not_submitted
  pending
  verified
}

enum OrderStatus {
  pending
  confirmed
  preparing
  shipped
  out_for_delivery
  delivered
  cancelled
  returned
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  upi
  card
  netbanking
  cod
}

enum RefundStatus {
  none
  requested
  approved
  rejected
}

enum ReturnStatus {
  requested
  approved
  rejected
  in_transit
  received
  refund_initiated
  refund_completed
  closed
  cancelled
}

enum ExchangeStatus {
  requested
  approved
  rejected
  in_transit
  received
  exchange_completed
  closed
  cancelled
}

enum CouponApplicableRole {
  all
  customers
  affiliate
}

enum CouponDiscountType {
  percentage
  fixed
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum ServiceBookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum ServiceBookingMode {
  instant
  after_24h
}

enum NotificationCategory {
  system
  customers
  affiliate_users
  new_products
  new_services
  new_orders
  withdraw_request
}

enum NotificationTargetRole {
  all
  customers
  affiliate_users
}

enum NotificationStatus {
  sent
  delivered
  read
}

enum CommissionType {
  order_commission
  manual_adjustment
  withdrawal
}

enum WithdrawalMethod {
  upi
  bank_transfer
}

enum WithdrawalStatus {
  pending
  approved
  rejected
  paid
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum SocialMediaPlatform {
  facebook
  instagram
  twitter
  linkedin
  youtube
  tiktok
}

enum PlatformPaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PlatformPaymentGateway {
  razorpay
  stripe
  paytm
  phonepe
}

enum PlanDuration {
  monthly
  quarterly
  yearly
}

enum TokenType {
  access
  refresh
  email_verify
  password_reset
}

// ============================================================
// AUTH TOKENS
// ============================================================

model AuthToken {
  id          String    @id @default(uuid())
  token       String    @unique
  type        TokenType
  userId      String?
  adminId     String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([adminId])
  @@map("auth_token")
}

// ============================================================
// ADMIN & SUPER ADMIN
// ============================================================

model Admin {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String
  role            AdminRole @default(admin)
  profileImage    String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  authTokens      AuthToken[]
  theme           AdminTheme?
  kycDocuments    AdminKycDocument[]
  withdrawalsProcessed WithdrawalRequest[] @relation("ProcessedBy")
  subscription    AdminSubscription?
  onboardingProgress AdminOnboardingProgress?
  notifications   Notification[]

  @@map("admin")
}

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("super_admin")
}

// ============================================================
// USER
// ============================================================

model User {
  id                String    @id @default(uuid())
  adminId           String?
  name              String
  email             String    @unique
  password          String?
  phone             String?
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  referralCode      String?   @unique
  referralBy        String?
  role              String    @default("customer")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  authTokens        AuthToken[]
  addresses         Address[]
  orders            Order[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           ReviewRating[]
  serviceBookings   ServiceBooking[]
  notifications     UserNotification[]
  returns           ReturnRequest[]
  exchanges         ExchangeRequest[]
  affiliateProfile  AffiliateProfile?

  @@map("user")
}

model UserKyc {
  id          String       @id @default(uuid())
  userId      String       @unique
  aadharUrl   String?
  panUrl      String?
  status      UserKycStatus @default(not_submitted)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("user_kyc")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id              String   @id @default(uuid())
  userId          String
  name            String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  pincode         String
  country         String   @default("India")
  addressType     String   @default("home")
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders  Order[]  @relation("OrderShippingAddress")
  billingOrders   Order[]  @relation("OrderBillingAddress")

  @@map("address")
}

// ============================================================
// AFFILIATE
// ============================================================

model AffiliateProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  referralCode          String   @unique
  referralLink          String?
  commissionRate        Float    @default(10)
  walletBalance         Float    @default(0)
  totalEarnings         Float    @default(0)
  totalWithdrawals      Float    @default(0)
  isActive              Boolean  @default(true)
  bankName              String?
  accountNumber         String?
  ifscCode              String?
  upiId                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals             AffiliateReferralTracking[]
  earnings              AffiliateEarning[]
  withdrawals           WithdrawalRequest[]

  @@map("affiliate_profile")
}

model AffiliateReferralTracking {
  id              String   @id @default(uuid())
  affiliateId     String
  referredUserId  String
  referralCode    String
  referralLink    String?
  referralSource  String?
  convertedAt     DateTime?
  conversionOrderId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  affiliate       AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([affiliateId, referredUserId])
  @@map("affiliate_referral_tracking")
}

model AffiliateEarning {
  id            String         @id @default(uuid())
  affiliateId   String
  orderId       String?
  amount        Float
  type          CommissionType
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_earning")
}

// ============================================================
// WITHDRAWAL
// ============================================================

model WithdrawalRequest {
  id              String            @id @default(uuid())
  affiliateId     String
  amount          Float
  method          WithdrawalMethod
  upiId           String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  status          WithdrawalStatus  @default(pending)
  minimumAmount   Int?
  note            String?
  requestedAt     DateTime          @default(now())
  processedAt     DateTime?
  paidAt          DateTime?
  processedBy     String?

  // Relations
  affiliate       AffiliateProfile   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  processedByAdmin Admin?            @relation("ProcessedBy", fields: [processedBy], references: [id])
  auditLogs       WithdrawalAudit[]

  @@map("withdrawal_request")
}

model WithdrawalAudit {
  id              String            @id @default(uuid())
  withdrawalId    String
  action          String
  previousStatus  String?
  newStatus       String?
  note            String?
  adminId         String?
  createdAt       DateTime          @default(now())

  // Relations
  withdrawal      WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@map("withdrawal_audit")
}

// ============================================================
// PRODUCT & INVENTORY
// ============================================================

model Product {
  id                String    @id @default(uuid())
  adminId           String?
  name              String
  category          String
  price             Float
  discountPrice     Float?
  commissionRate    Float?
  stock             Int       @default(0)
  stockStatus       String    @default("in_stock")
  status            String    @default("active")
  image             String?
  images            String[]
  description       String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isAffiliateProduct Boolean  @default(false)
  sellerId          String?
  sku               String?
  stockThreshold    Int?
  stockLocation     String?
  supplier          String?
  inventoryNotes    String?

  // Relations
  inventory         Inventory[]
  orderItems        OrderItem[]
  couponApplicable  CouponApplicableProduct[]
  reviews           ReviewRating[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]

  @@map("product")
}

model Inventory {
  id            String    @id @default(uuid())
  productId     String
  quantity      Int       @default(0)
  reservedQty   Int       @default(0)
  availableQty  Int       @default(0)
  location      String?
  lastUpdated   DateTime  @default(now())
  updatedBy     String?

  // Relations
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs          InventoryLog[]

  @@map("inventory")
}

model InventoryLog {
  id            String    @id @default(uuid())
  inventoryId   String
  changeType    String
  changeAmount  Int
  previousQty   Int
  newQty        Int
  reason        String?
  referenceId   String?
  adminId      String?
  createdAt    DateTime  @default(now())

  // Relations
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@map("inventory_logs")
}

// ============================================================
// COUPON
// ============================================================

model Coupon {
  id                      String              @id @default(uuid())
  code                    String              @unique
  discountType            CouponDiscountType
  discountValue           Float
  minimumOrderAmount      Float?
  usageLimitTotal         Int?
  usageLimitPerUser       Int?
  maxDiscountCap          Float?
  applicableRole          CouponApplicableRole @default(all)
  startDate               DateTime?
  endDate                 DateTime?
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Relations
  applicableProducts      CouponApplicableProduct[]
  applicableCategories     CouponApplicableCategory[]
  orders                  Order[]

  @@map("coupon")
}

model CouponApplicableProduct {
  id        String  @id @default(uuid())
  couponId  String
  productId String

  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@map("coupon_applicable_product")
}

model CouponApplicableCategory {
  id        String  @id @default(uuid())
  couponId  String
  category  String

  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, category])
  @@map("coupon_applicable_category")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id                String        @id @default(uuid())
  userId            String
  orderNumber       String        @unique
  orderStatus       OrderStatus   @default(pending)
  paymentStatus     PaymentStatus @default(pending)
  paymentMethod     PaymentMethod?
  refundStatus      RefundStatus  @default(none)
  trackingNumber    String?
  trackingUrl       String?
  notes             String?
  productsCount     Int           @default(0)
  subTotal          Float
  discount          Float         @default(0)
  tax               Float         @default(0)
  shipping          Float         @default(0)
  totalAmount       Float
  shippingAddressId String?
  billingAddressId  String?
  couponId          String?
  affiliateId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  user              User          @relation(fields: [userId], references: [id])
  shippingAddress   Address?      @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress    Address?      @relation("OrderBillingAddress", fields: [billingAddressId], references: [id])
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  items             OrderItem[]
  payment           Payment?

  @@map("order")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId      String
  productName    String
  productImage    String?
  quantity        Int
  price           Float
  discount        Float    @default(0)
  tax             Float    @default(0)
  total           Float
  returnStatus    String?
  exchangeStatus  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@map("order_item")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              String            @id @default(uuid())
  orderId         String            @unique
  amount          Float
  currency        String            @default("INR")
  status          PaymentStatus     @default(pending)
  method          String?
  transactionId   String?
  gatewayResponse String?
  refundAmount    Float?
  refundReason    String?
  refundedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment")
}

// ============================================================
// CART & WISHLIST
// ============================================================

model CartItem {
  id          String   @id @default(uuid())
  userId      String
  productId   String
  quantity    Int      @default(1)
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_item")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  addedAt   DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_item")
}

// ============================================================
// RETURN & EXCHANGE & REFUND
// ============================================================

model ReturnRequest {
  id              String        @id @default(uuid())
  orderId         String
  userId          String
  reason          String
  productId       String?
  quantity        Int           @default(1)
  status          ReturnStatus  @default(requested)
  images          String[]
  adminNote       String?
  refundAmount    Float?
  pickupAddressId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user            User          @relation(fields: [userId], references: [id])
  timeline        ReturnTimeline[]
  refund          RefundDetails?

  @@map("return_request")
}

model ReturnTimeline {
  id            String   @id @default(uuid())
  returnId      String
  status        String
  note          String?
  updatedBy     String?
  createdAt     DateTime @default(now())

  // Relations
  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_timeline")
}

model RefundDetails {
  id                  String           @id @default(uuid())
  returnId            String           @unique
  method              String           // bank_transfer | upi | original_source
  accountHolderName   String?
  bankName            String?
  accountNumber       String?
  ifscCode            String?
  upiId               String?
  amount              Float?
  status              String?
  initiatedAt         DateTime?
  completedAt         DateTime?
  failureReason       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  returnRequest       ReturnRequest    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  auditLogs           RefundAuditLog[]

  @@map("refund_details")
}

model RefundAuditLog {
  id          String        @id @default(uuid())
  refundId    String
  action      String
  previousStatus String?
  newStatus   String?
  note        String?
  adminId     String?
  createdAt   DateTime      @default(now())

  // Relations
  refund      RefundDetails @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@map("refund_audit_log")
}

model ExchangeRequest {
  id              String          @id @default(uuid())
  orderId         String
  userId          String
  productId       String?
  reason          String
  exchangeProductId String?
  quantity        Int             @default(1)
  status          ExchangeStatus  @default(requested)
  images          String[]
  adminNote       String?
  shippingAddressId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  user            User            @relation(fields: [userId], references: [id])
  timeline        ExchangeTimeline[]

  @@map("exchange_request")
}

model ExchangeTimeline {
  id            String          @id @default(uuid())
  exchangeId    String
  status        String
  note          String?
  updatedBy     String?
  createdAt     DateTime        @default(now())

  // Relations
  exchange      ExchangeRequest @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@map("exchange_timeline")
}

// ============================================================
// REVIEWS
// ============================================================

model ReviewRating {
  id          String       @id @default(uuid())
  userId      String
  productId   String
  orderId     String?
  rating      Int
  comment     String?
  images      String[]
  status      ReviewStatus @default(pending)
  adminNote   String?
  isVerifiedPurchase Boolean @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  user        User         @relation(fields: [userId], references: [id])
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@map("review_rating")
}

// ============================================================
// SERVICE BOOKING
// ============================================================

model MyService {
  id                    String    @id @default(uuid())
  adminId               String?
  name                  String
  category              String
  description           String?
  duration              String?
  price                 Float
  discountedPrice       Float?
  images                String[]
  howToUseType          String    @default("text")
  howToUseText          String?
  howToUseVideo         String?
  workingHours          String?
  workingDays           String?
  bookingConfirmationMode ServiceBookingMode @default(instant)
  status                String    @default("active")
  isFeatured            Boolean   @default(false)
  totalBookings         Int       @default(0)
  avgRating             Float?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  bookings              ServiceBooking[]

  @@map("my_service")
}

model ServiceBooking {
  id            String              @id @default(uuid())
  userId        String
  serviceId     String
  bookingDate   DateTime
  bookingTime   String
  status        ServiceBookingStatus @default(pending)
  customerName  String?
  customerPhone String?
  notes         String?
  totalAmount   Float?
  couponCode    String?
  discountAmount Float?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  // Relations
  user          User                @relation(fields: [userId], references: [id])
  service       MyService           @relation(fields: [serviceId], references: [id])

  @@map("service_booking")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id              String                  @id @default(uuid())
  adminId         String?
  title           String
  message         String
  category        NotificationCategory
  targetRole      NotificationTargetRole
  imageUrl        String?
  targetUserIds   String[]
  status          NotificationStatus @default(sent)
  sentAt          DateTime?
  locationState   String?
  locationCity    String?
  locationPincode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  sentBy          Admin?   @relation(fields: [adminId], references: [id])

  @@map("notification")
}

model UserNotification {
  id            String   @id @default(uuid())
  userId        String
  title         String
  message       String
  imageUrl      String?
  type          String?
  referenceId   String?
  isRead        Boolean  @default(false)
  readAt        DateTime?
  createdAt     DateTime @default(now())

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_notification")
}

// ============================================================
// SUBSCRIPTION
// ============================================================

model SubscriptionPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  duration    PlanDuration
  features    String[]
  maxProducts Int?
  maxOrders   Int?
  addonAccess String[]
  isActive    Boolean  @default(true)
  sortOrder   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subscriptions AdminSubscription[]

  @@map("subscription_plan")
}

model PlanAddon {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("plan_addon")
}

model AdminSubscription {
  id              String              @id @default(uuid())
  adminId         String              @unique
  planId          String
  startDate       DateTime
  expiryDate      DateTime
  status          SubscriptionStatus  @default(active)
  billingCycle    String?
  autoRenew       Boolean             @default(false)
  nextBillingDate DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  admin           Admin               @relation(fields: [adminId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan    @relation(fields: [planId], references: [id])

  @@map("admin_subscription")
}

model AdminOnboardingProgress {
  id                  String   @id @default(uuid())
  adminId             String   @unique
  storeName           String?
  storeDescription    String?
  businessCategory    String?
  stepCompleted       Int      @default(1)
  storeLogoUploaded   Boolean  @default(false)
  storeBannerUploaded Boolean  @default(false)
  contactInfoUpdated  Boolean  @default(false)
  bankDetailsUpdated  Boolean  @default(false)
  kycUploaded         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  admin               Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_onboarding_progress")
}

model AdminKycDocument {
  id          String   @id @default(uuid())
  adminId     String
  type        String
  fileUrl     String
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_kyc_document")
}

// ============================================================
// THEME
// ============================================================

model WebTheme {
  id              String   @id @default(uuid())
  name            String
  primaryColor    String   @default("#2563EB")
  secondaryColor  String   @default("#EFF6FF")
  accentColor     String   @default("#1E40AF")
  buttonColor     String   @default("#2563EB")
  backgroundColor String   @default("#FFFFFF")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  adminThemes     AdminTheme[]

  @@map("web_theme")
}

model AdminTheme {
  id              String   @id @default(uuid())
  adminId         String   @unique
  webThemeId      String?
  customTitle     String?
  customDescription String?
  customCtaText   String?
  customBannerUrl String?
  isActive        Boolean  @default(true)
  purchasedAt     DateTime?
  platformPaymentId String?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  // Relations
  admin           Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  webTheme        WebTheme? @relation(fields: [webThemeId], references: [id])

  @@map("admin_theme")
}

// ============================================================
// SOCIAL MEDIA
// ============================================================

model SocialMediaManage {
  id        String             @id @default(uuid())
  adminId   String
  platform  SocialMediaPlatform
  url       String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([adminId, platform])
  @@map("social_media_manage")
}

// ============================================================
// PLATFORM PAYMENT (Platform's own payment records)
// ============================================================

model PlatformPayment {
  id              String               @id @default(uuid())
  adminId         String
  amount          Float
  currency        String               @default("INR")
  status          PlatformPaymentStatus @default(pending)
  gateway         PlatformPaymentGateway
  transactionId   String?
  planId          String?
  gatewayResponse String?
  refundedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("platform_payment")
}