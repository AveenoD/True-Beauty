# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (Prisma) ---
#
# Easiest (Docker — fixed credentials, no P1000):
#   From repo root:  docker compose up -d
#   From backend:    npm run db:up
#   Then:            npm run prisma:deploy
#   DATABASE_URL (port 5433):
#   postgresql://postgres:postgres@localhost:5433/truebeauty?schema=public
#
# If you use your own PostgreSQL instead, P1000 means USER:PASSWORD in URL is wrong.
# Create DB: CREATE DATABASE truebeauty;
# URL-encode special characters in passwords (@ → %40, etc.).
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/truebeauty?schema=public"

# Server
PORT=9797
# Optional: Swagger "Try it out" base URL (defaults to http://localhost:${PORT})
# API_BASE_URL=http://localhost:9797
NODE_ENV=development

# Global API rate limit (per IP). Default 100 requests per RATE_LIMIT_WINDOW minutes.
# If you see 429 in dev (HMR + many calls), raise RATE_LIMIT_MAX or widen RATE_LIMIT_WINDOW.
# Token refresh routes are excluded from this limiter so a 429 there cannot mimic a logout.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW=15

# Logs: pretty = indented JSON in terminal (default in dev). json = one line per event (default in production, for aggregators).
# LOG_FORMAT=pretty
# LOG_FORMAT=json

# CORS: comma-separated browser origins (frontend). The API also allows its own origin
# (same port as PORT / API_BASE_URL) so Swagger UI at /docs can call the API without CORS errors.
CORS_ORIGIN=http://localhost:3000

# Links in verification emails / dev console log
FRONTEND_URL=http://localhost:3000

# SMTP (required to actually receive emails)
# Example: Gmail SMTP (use App Password), or your provider SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=no-reply@truebeauty.com
MAIL_FROM_NAME="True Beauty"

# JWT — use long random strings in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
